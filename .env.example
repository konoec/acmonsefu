# =============================================================
# Variables para funcionalidades dinámicas (futuro: festival 2027)
# El sitio Astro actual es 100% estático y NO las necesita.
# =============================================================

# URL del proyecto (Settings → API → Project URL)
VITE_SUPABASE_URL=

# anon/public key — SEGURA para el frontend (build y dev)
VITE_SUPABASE_ANON_KEY=

# service_role key — SOLO para el SQL Editor o un backend server-side.
# NO ponerla en el frontend ni en el build estático (quedaría expuesta).
# No es necesaria para el sitio actual.