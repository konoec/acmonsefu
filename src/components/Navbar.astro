---
import logoAsociacion from "../assets/images/logos/logo_icono.png";

const { pathname } = Astro.url;

const links = [
  { label: "Inicio", href: "/" },
  { label: "Nosotros", href: "/nosotros" },
  { label: "Servicios", href: "/servicios" },
  { label: "Novedades", href: "/novedades" },
  { label: "Contacto", href: "/contacto" },
];

function isActive(href) {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-50 w-full border-b border-gray-100 bg-cream-50/90 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 lg:px-8" aria-label="Principal">
    <a href="/" class="flex items-center gap-2.5" aria-label="Ir al inicio">
      <img src={logoAsociacion.src} alt="Logo AC Monsefú" class="h-10 w-auto object-contain" width="120" height="40" />
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              "text-[13px] font-bold uppercase tracking-widest transition-colors",
              isActive(link.href) ? "text-brand-600" : "text-gray-600 hover:text-brand-600",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href="/golpe-tierra"
      class:list={[
        "hidden rounded-sm bg-brand-600 px-4 py-2 text-[11px] font-black uppercase tracking-[0.15em] text-white transition-colors hover:bg-brand-700 lg:inline-flex",
        isActive("/golpe-tierra") && "ring-2 ring-brand-600 ring-offset-2 ring-offset-cream-50",
      ]}
    >
      Festival
    </a>

    <details class="group relative lg:hidden">
      <summary
        class="flex h-10 w-10 list-none cursor-pointer items-center justify-center rounded-sm text-gray-700 transition-colors hover:bg-gray-100"
        aria-label="Abrir menú"
      >
        <svg class="h-6 w-6 group-open:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden h-6 w-6 group-open:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </summary>
      <div class="absolute right-0 top-12 w-56 rounded-sm border border-gray-100 bg-white p-2 shadow-xl">
        <ul class="flex flex-col gap-1">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "block rounded-sm px-3 py-2.5 text-xs font-bold uppercase tracking-widest transition-colors",
                  isActive(link.href) ? "bg-brand-600/10 text-brand-600" : "text-gray-700 hover:bg-gray-50",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
          <li class="mt-1 border-t border-gray-100 pt-1">
            <a
              href="/golpe-tierra"
              class="block rounded-sm bg-brand-600 px-3 py-2.5 text-center text-xs font-black uppercase tracking-widest text-white"
            >
              Festival Golpe Tierra
            </a>
          </li>
        </ul>
      </div>
    </details>
  </nav>
</header>