---
import Layout from "../../layouts/Layout.astro";
import proyectosData from "../../data/proyectos.json";
import { md } from "../../lib/text";

export function getStaticPaths() {
  const proyectos = proyectosData.proyectos.filter((p) => p.gallery?.length);
  return proyectos.map((p) => ({
    params: { slug: p.id },
    props: { proyecto: p },
  }));
}

const { proyecto } = Astro.props;
const imagenes = [proyecto.image, ...(proyecto.gallery || [])].filter(Boolean);
const descripcion = proyecto.paragraphs?.length ? proyecto.paragraphs : [proyecto.text];
---

<Layout
  title={`${proyecto.title} | Asociación Cultural Monsefú`}
  description={proyecto.text}
>
  <section class="border-b border-gray-100 bg-cream-50">
    <div class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
      <a href="/proyectos" class="text-[11px] font-bold uppercase tracking-[0.25em] text-brand-600 transition-colors hover:text-brand-700">
        ← Proyectos
      </a>
      <p class="mt-6 text-[11px] font-bold uppercase tracking-[0.3em] text-brand-600">{proyecto.tag}</p>
      <h1 class="mt-3 max-w-2xl font-heading text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
        {proyecto.title}
      </h1>
      <div class="mt-5 max-w-2xl space-y-4 text-lg leading-relaxed text-gray-600">
        {descripcion.map((parrafo) => (
          <p set:html={md(parrafo)} />
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
      {imagenes.map((src, i) => (
        <img
          src={src}
          alt={`${proyecto.title} — foto ${i + 1}`}
          class={`aspect-square w-full rounded-sm object-cover transition-transform duration-300 hover:scale-[1.03] ${i === 0 ? "col-span-2 row-span-2" : ""}`}
          width="400"
          height="400"
          loading="lazy"
        />
      ))}
    </div>
  </section>
</Layout>