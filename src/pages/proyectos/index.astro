---
import Layout from "../../layouts/Layout.astro";
import SITE from "../../data/site.json";
import festivalData from "../../data/festival.json";
import PROYECTOS from "../../data/proyectos.json";
import seccion from "../../data/secciones/proyectos.json";
import imagenes from "../../data/imagenes.json";
import { t } from "../../lib/text";

const FESTIVAL = festivalData.festival;

const featured = PROYECTOS.find((p) => p.featured);
const otros = PROYECTOS.filter((p) => !p.featured);
---

<Layout
  title={seccion.meta.title}
  description={seccion.meta.description}
>
  <section class="border-b border-gray-100 bg-cream-50">
    <div class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
      <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-brand-600">{seccion.header.eyebrow}</p>
      <h1 class="mt-3 max-w-2xl font-heading text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
        {seccion.header.title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-600">
        {seccion.header.description}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
    <article class="relative overflow-hidden rounded-sm bg-gradient-to-br from-gray-900 via-gray-900 to-brand-800 text-white">
      <div class="pointer-events-none absolute -right-24 top-0 h-96 w-96 rounded-full bg-brand-500/20 blur-[100px]"></div>
      <div class="relative grid grid-cols-1 items-center gap-10 p-8 md:grid-cols-2 md:p-14">
        <div>
          <span class="inline-block rounded-sm bg-white/10 px-3 py-1 text-[10px] font-black uppercase tracking-[0.2em] text-white/90">
            {featured.tag}
          </span>
          <h2 class="mt-5 font-heading text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
            {featured.title}
          </h2>
          <p class="mt-3 inline-block rounded-sm bg-white/10 px-3 py-1 text-[11px] font-black uppercase tracking-[0.25em] text-white/90">
            {FESTIVAL.edition} · {FESTIVAL.year}
          </p>
          <p class="mt-5 text-base leading-relaxed text-white/80">{featured.text}</p>
          <p class="mt-4 text-sm text-white/60">Lugar: {FESTIVAL.place}</p>
          <a
            href={featured.href}
            class="mt-8 inline-flex items-center justify-center rounded-sm bg-white px-8 py-4 text-xs font-black uppercase tracking-[0.15em] text-brand-700 transition-all hover:bg-gray-100"
          >
            {seccion.featured.cta}
          </a>
        </div>
        <div class="flex items-center justify-center">
          <img
            src={imagenes.logos.festivalLight.src}
            alt={imagenes.logos.festivalLight.alt}
            class="h-28 w-auto object-contain sm:h-36"
            width="200"
            height="100"
          />
        </div>
      </div>
    </article>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
      {otros.map((proyecto) => (
        <a
          href="#presentaciones"
          class="group flex flex-col rounded-sm border border-gray-100 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-xl"
        >
          <div class="flex items-center justify-between">
            <div class="flex h-12 w-12 items-center justify-center rounded-sm bg-brand-600 text-white transition-colors group-hover:bg-brand-700">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
                <path d={proyecto.icon} />
              </svg>
            </div>
            <span class="rounded-sm bg-gray-100 px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.15em] text-gray-500">
              {proyecto.tag}
            </span>
          </div>
          <h2 class="mt-5 font-heading text-xl font-bold text-gray-900">{proyecto.title}</h2>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-gray-500">{proyecto.text}</p>
          <span class="mt-6 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.15em] text-brand-600">
            Conocer más
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section id="presentaciones" class="border-t border-gray-100 bg-cream-50">
    <div class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
      <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-brand-600">Presentaciones</p>
      <h2 class="mt-3 max-w-2xl font-heading text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
        Shows, talleres y eventos institucionales
      </h2>
      <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
        {otros.map((proyecto) => (
          <article class="flex flex-col rounded-sm border border-gray-100 bg-white p-8">
            <span class="rounded-sm bg-brand-600 px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.15em] text-white self-start">
              {proyecto.tag}
            </span>
            <h3 class="mt-4 font-heading text-xl font-bold text-gray-900">{proyecto.title}</h3>
            {proyecto.paragraphs && (
              <div class="mt-4 space-y-3 text-sm leading-relaxed text-gray-600">
                {proyecto.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            )}
            {proyecto.items && (
              <ul class="mt-4 space-y-3">
                {proyecto.items.map((item) => (
                  <li class="flex items-baseline justify-between gap-3 border-b border-gray-100 pb-2 text-sm">
                    <span class="font-semibold text-gray-900">{item.name}</span>
                    <span class="shrink-0 text-xs uppercase tracking-[0.1em] text-brand-600">{item.month}</span>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-gradient-to-br from-gray-900 to-gray-800">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-5 py-20 text-center lg:flex-row lg:justify-between lg:px-8 lg:text-left">
      <div class="max-w-xl">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          {t(seccion.cta.title, { name: FESTIVAL.name })}
        </h2>
        <p class="mt-3 text-base leading-relaxed text-white/80">
          {t(seccion.cta.text, { name: FESTIVAL.name })}
        </p>
      </div>
      <a
        href={SITE.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-2 rounded-sm bg-brand-600 px-8 py-4 text-xs font-black uppercase tracking-[0.15em] text-white transition-all hover:bg-brand-500"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.9-1.4A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20Zm4.5-6c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4 0-.5.1-.6l.5-.6c.1-.2.1-.3.2-.5v-.5c0-.1-.5-1.2-.7-1.6-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4 0-.6.3-.2.3-.8.8-.8 1.9s.8 2.2.9 2.4c.1.2 1.6 2.5 3.9 3.5.5.2.9.4 1.3.5.5.2 1 .1 1.4.1.4-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z" />
        </svg>
        {seccion.cta.label}
      </a>
    </div>
  </section>
</Layout>