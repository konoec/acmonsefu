---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada" description="La página que buscas no existe.">
  <section class="mx-auto max-w-3xl px-5 py-32 text-center">
    <p class="font-heading text-7xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-4 font-heading text-3xl font-extrabold tracking-tight text-gray-900">Página no encontrada</h1>
    <p class="mt-4 text-gray-500">La página que buscas no existe o fue movida.</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center justify-center rounded-sm bg-gray-900 px-8 py-4 text-xs font-bold uppercase tracking-[0.15em] text-white transition-all hover:bg-brand-600"
    >
      Volver al inicio
    </a>
  </section>
</Layout>