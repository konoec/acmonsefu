---

<Layout
  title="Contacto"
  description="Contacta a la Asociación Cultural Monsefú por WhatsApp, correo o redes sociales."
>
  <section class="border-b border-gray-100 bg-cream-50">
    <div class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
      <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-brand-600">Contacto</p>
      <h1 class="mt-3 max-w-2xl font-heading text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
        Hablemos
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-600">
        ¿Tienes un proyecto, quieres contratar un espectáculo o participar en nuestros eventos? Escríbenos.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {canales.map((canal) => (
        <a
          href={canal.href}
          target={canal.href.startsWith("http") ? "_blank" : undefined}
          rel={canal.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="group flex flex-col items-start rounded-sm border border-gray-100 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-xl"
        >
          <div class="flex h-12 w-12 items-center justify-center rounded-sm bg-brand-600/10 text-brand-600 transition-colors group-hover:bg-brand-600 group-hover:text-white">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
              <path d={canal.icon} />
            </svg>
          </div>
          <h2 class="mt-5 font-heading text-lg font-bold text-gray-900">{canal.title}</h2>
          <p class="mt-1 text-sm text-gray-500">{canal.value}</p>
        </a>
      ))}
    </div>

    <div class="mt-14 flex flex-col items-center gap-6 rounded-sm bg-gradient-to-br from-brand-600 to-brand-700 p-10 text-center">
      <p class="font-heading text-2xl font-extrabold tracking-tight text-white sm:text-3xl">Síguenos en redes</p>
      <div class="flex gap-4">
        {socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.name}
            class="flex h-12 w-12 items-center justify-center rounded-sm bg-white/10 text-white transition-all hover:bg-white hover:text-brand-600"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d={social.icon} />
            </svg>
          </a>
        ))}
      </div>
      <p class="max-w-md text-sm text-white/80">
        Compartimos novedades, convocatorias y resultados de nuestros eventos. ¡No te lo pierdas!
      </p>
    </div>
  </section>
</Layout>