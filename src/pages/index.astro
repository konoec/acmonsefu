---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import SITE from "../data/site.json";
import festivalData from "../data/festival.json";
import proyectosData from "../data/proyectos.json";
import seccion from "../data/secciones/home.json";
import imagenes from "../data/imagenes.json";
import { md } from "../lib/text.js";

const MODALIDADES = festivalData.modalidades;

const noticias = (await getCollection("noticias"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const marquee = [...new Set(MODALIDADES.map((m) => m.title))];
const PROYECTOS = proyectosData.proyectos;
const featuredProject = PROYECTOS.find((p) => p.featured);
const otherProjects = PROYECTOS.filter((p) => !p.featured);
---

<Layout
  title={seccion.meta.title}
  description={seccion.meta.description}
>
  <section class="relative overflow-hidden bg-cream-50">
    <div class="pointer-events-none absolute -top-24 right-0 h-96 w-96 rounded-full bg-brand-500/10 blur-[90px]"></div>
    <div class="pointer-events-none absolute bottom-0 left-0 h-80 w-80 rounded-full bg-amber-200/20 blur-[90px]"></div>

    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-5 pb-20 pt-16 lg:grid-cols-2 lg:px-8 lg:pb-28 lg:pt-24">
      <div class="relative z-10 order-1 flex items-center justify-center">
        <img
          src={imagenes.logos.asociacion.src}
          alt={imagenes.logos.asociacion.alt}
          class="h-40 w-auto object-contain sm:h-72 lg:h-80"
          width="560"
          height="560"
        />
      </div>

      <div class="relative z-10 order-2">
        <h1 class="font-heading text-4xl font-extrabold leading-[1.05] tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
          {SITE.fullName}
        </h1>
        <p class="mt-4 max-w-lg text-lg leading-relaxed text-gray-600">{SITE.tagline}.</p>
        <p class="mt-4 max-w-lg text-base leading-relaxed text-gray-500" set:html={md(seccion.hero.description)}></p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={seccion.hero.ctaPrimary.href}
            class="inline-flex items-center justify-center rounded-sm bg-gray-900 px-6 py-3 text-xs font-bold uppercase tracking-[0.15em] text-white transition-all hover:bg-brand-600"
          >
            {seccion.hero.ctaPrimary.label}
          </a>
          <a
            href={seccion.hero.ctaSecondary.href}
            class="inline-flex items-center justify-center rounded-sm border border-brand-600 px-6 py-3 text-xs font-bold uppercase tracking-[0.15em] text-brand-600 transition-all hover:bg-brand-600 hover:text-white"
          >
            {seccion.hero.ctaSecondary.label}
          </a>
        </div>
      </div>
    </div>

    <div class="overflow-hidden border-y border-gray-100 bg-white py-3">
      <div class="flex w-max animate-marquee items-center gap-10">
        {[...marquee, ...marquee, ...marquee, ...marquee].map((name, i) => (
          <span key={i} class="flex items-center gap-10 whitespace-nowrap text-[11px] font-bold uppercase tracking-[0.25em] text-gray-400">
            {name}
            <span class="h-1 w-1 rounded-full bg-gray-300"></span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div class="relative">
        <img
          src={imagenes.home.about.src}
          alt={imagenes.home.about.alt}
          class="aspect-[4/3] w-full rounded-sm object-cover shadow-xl"
          width="800"
          height="600"
        />
      </div>
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-brand-600">{seccion.quienesSomos.eyebrow}</p>
        <h2 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
          {seccion.quienesSomos.title}
        </h2>
        {seccion.quienesSomos.paragraphs.map((parrafo) => (
          <p class="mt-4 text-base leading-relaxed text-gray-600" set:html={md(parrafo)}></p>
        ))}
        <a
          href={seccion.quienesSomos.link.href}
          class="mt-6 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.15em] text-brand-600 transition-colors hover:text-brand-700"
        >
          {seccion.quienesSomos.link.label}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-6xl px-5 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-brand-600">{seccion.proyectos.eyebrow}</p>
          <h2 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
            {seccion.proyectos.title}
          </h2>
        </div>
        <a
          href="/proyectos"
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.15em] text-brand-600 transition-colors hover:text-brand-700"
        >
          {seccion.proyectos.seeAll}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>

      <div class="mt-12 overflow-hidden rounded-sm bg-gradient-to-br from-gray-900 via-gray-900 to-brand-800 text-white">
        <div class="grid grid-cols-1 items-center gap-8 p-8 md:grid-cols-[1fr_auto] md:p-12">
          <div>
            <span class="inline-block rounded-sm bg-white/10 px-3 py-1 text-[10px] font-black uppercase tracking-[0.2em] text-white/90">
              {featuredProject.tag}
            </span>
            <h3 class="mt-4 font-heading text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
              {featuredProject.title}
            </h3>
            <p class="mt-3 max-w-xl text-base leading-relaxed text-white/80">{featuredProject.text}</p>
            <a
              href={featuredProject.href}
              class="mt-6 inline-flex items-center justify-center rounded-sm bg-white px-8 py-3.5 text-xs font-black uppercase tracking-[0.15em] text-brand-700 transition-all hover:bg-gray-100"
            >
              {seccion.proyectos.cta}
            </a>
          </div>
          <div class="flex items-center justify-center">
            <img
              src={imagenes.logos.festivalLight.src}
              alt={imagenes.logos.festivalLight.alt}
              class="h-24 w-auto object-contain md:h-32"
              width="180"
              height="80"
            />
          </div>
        </div>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
        {otherProjects.map((proyecto) => (
          <a
            href={proyecto.href}
            class="group rounded-sm border border-gray-100 bg-cream-50 p-7 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-xl"
          >
            <div class="flex h-11 w-11 items-center justify-center rounded-sm bg-brand-600 text-white transition-colors group-hover:bg-brand-700">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                <path d={proyecto.icon} />
              </svg>
            </div>
            <h3 class="mt-5 font-heading text-lg font-bold text-gray-900">{proyecto.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-500">{proyecto.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-brand-600">{seccion.novedades.eyebrow}</p>
        <h2 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
          {seccion.novedades.title}
        </h2>
      </div>
      <a
        href="/novedades"
        class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.15em] text-brand-600 transition-colors hover:text-brand-700"
      >
        {seccion.novedades.seeAll}
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {noticias.map((post) => (
        <a
          href={`/novedades/${post.id}`}
          class="group rounded-sm border border-gray-100 bg-white p-7 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-xl"
        >
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-gray-400">
            {post.data.date.toLocaleDateString("es-PE", { day: "2-digit", month: "long", year: "numeric" })}
          </p>
          <h3 class="mt-3 font-heading text-lg font-bold leading-snug text-gray-900 transition-colors group-hover:text-brand-600">
            {post.data.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-500">{post.data.excerpt}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-t border-gray-100 bg-white">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-5 py-16 text-center lg:flex-row lg:justify-between lg:px-8 lg:text-left">
      <div>
        <h2 class="font-heading text-2xl font-extrabold tracking-tight text-gray-900">{seccion.contacto.title}</h2>
        <p class="mt-2 text-gray-500">{seccion.contacto.text}</p>
      </div>
      <a
        href="/contacto"
        class="inline-flex shrink-0 items-center justify-center rounded-sm bg-gray-900 px-8 py-4 text-xs font-bold uppercase tracking-[0.15em] text-white transition-all hover:bg-brand-600"
      >
        {seccion.contacto.cta}
      </a>
    </div>
  </section>
</Layout>