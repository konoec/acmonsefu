---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const noticias = (await getCollection("noticias")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  title="Novedades"
  description="Noticias y novedades de la Asociación Cultural Monsefú."
>
  <section class="border-b border-gray-100 bg-cream-50">
    <div class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-24">
      <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-brand-600">Novedades</p>
      <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
        Noticias y anuncios
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-600">
        Enterate de nuestras actividades, convocatorias y novedades culturales.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8">
    {noticias.length === 0 ? (
      <p class="text-gray-500">Próximamente publicaremos nuestras novedades.</p>
    ) : (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {noticias.map((post) => (
          <a
            href={`/novedades/${post.id}`}
            class="group flex flex-col rounded-sm border border-gray-100 bg-white p-7 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-xl"
          >
            <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-gray-400">
              {post.data.date.toLocaleDateString("es-PE", { day: "2-digit", month: "long", year: "numeric" })}
            </p>
            <h2 class="mt-3 flex-1 font-heading text-lg font-bold leading-snug text-gray-900 transition-colors group-hover:text-brand-600">
              {post.data.title}
            </h2>
            {post.data.excerpt && <p class="mt-3 text-sm leading-relaxed text-gray-500">{post.data.excerpt}</p>}
            <span class="mt-5 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.15em] text-brand-600">
              Leer más
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>