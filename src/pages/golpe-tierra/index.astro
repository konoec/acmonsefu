---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { FESTIVAL, MODALIDADES } from "../../data/festival";
import { SITE } from "../../data/site";
import logoFestival from "../../assets/images/logos/logo_festival.webp";

const galleryImages = Object.values(
  import.meta.glob("../../assets/images/galeria/*.webp", { eager: true, import: "default" }),
);
---

<Layout
  title={`${FESTIVAL.name} ${FESTIVAL.year} | ${FESTIVAL.edition}`}
  description={`${FESTIVAL.name}: concurso de danzas tradicionales organizado por ${SITE.fullName}. ${FESTIVAL.place}.`}
>
  <section class="relative overflow-hidden bg-gradient-to-br from-gray-900 via-gray-900 to-brand-800 text-white">
    <div class="pointer-events-none absolute -right-24 top-0 h-96 w-96 rounded-full bg-brand-500/20 blur-[100px]"></div>
    <div class="mx-auto max-w-6xl px-5 py-24 lg:px-8 lg:py-32">
      <img src={logoFestival.src} alt={`Logo ${FESTIVAL.name}`} class="h-20 w-auto object-contain" width="160" height="80" />
      <h1 class="mt-6 font-heading text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
        {FESTIVAL.name}
      </h1>
      <p class="mt-3 inline-block rounded-sm bg-white/10 px-3 py-1 text-[11px] font-black uppercase tracking-[0.25em] text-white/90">
        {FESTIVAL.edition} · {FESTIVAL.year}
      </p>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80">{FESTIVAL.description}</p>

      <div class="mt-10 grid max-w-2xl grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="rounded-sm bg-white/5 p-5 backdrop-blur">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/60">Lugar</p>
          <p class="mt-2 text-sm font-semibold text-white">{FESTIVAL.place}</p>
        </div>
        <div class="rounded-sm bg-white/5 p-5 backdrop-blur">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/60">Inscripciones</p>
          <p class="mt-2 text-sm font-semibold text-white">{FESTIVAL.registrationDates}</p>
        </div>
        <div class="rounded-sm bg-white/5 p-5 backdrop-blur">
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/60">Contacto</p>
          <p class="mt-2 text-sm font-semibold text-white">{FESTIVAL.contact}</p>
        </div>
      </div>

      <div class="mt-10">
        <span class="inline-flex items-center rounded-sm bg-white px-6 py-3.5 text-xs font-black uppercase tracking-[0.15em] text-brand-700">
          Inscripciones abren próximamente
        </span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
    <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-brand-600">Reglamento</p>
    <h2 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
      Bases de competencia
    </h2>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="rounded-sm border border-gray-100 bg-white p-7">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-brand-600">Costos</p>
        <div class="mt-4 space-y-2">
          {FESTIVAL.costs.map((cost) => (
            <p class="flex items-center justify-between border-b border-gray-100 pb-2 text-sm text-gray-600">
              <span>{cost.label}</span>
              <span class="font-semibold italic text-gray-900">{cost.price}</span>
            </p>
          ))}
        </div>
      </article>
      <article class="rounded-sm border border-gray-100 bg-white p-7">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-blue-600">Requisitos</p>
        <ul class="mt-4 space-y-2 text-sm text-gray-600">
          <li class="flex items-center gap-2">
            <span class="h-1 w-1 rounded-full bg-blue-400"></span> Registro vía WhatsApp
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1 w-1 rounded-full bg-blue-400"></span> DNI original (bailarines)
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1 w-1 rounded-full bg-blue-400"></span> Voucher de pago (Yape)
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1 w-1 rounded-full bg-blue-400"></span> Nombre de la academia
          </li>
        </ul>
      </article>
      <article class="rounded-sm border border-gray-100 bg-white p-7">
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-green-600">Calificación</p>
        <p class="mt-4 text-sm leading-relaxed text-gray-600">
          Puntaje mediante paleta en mano de <strong class="text-gray-900">3 a 5 puntos</strong>.
        </p>
        <div class="mt-4 space-y-1 text-sm text-gray-500">
          <p><span class="font-semibold text-gray-900">Semifinal:</span> máximo 6 parejas</p>
          <p><span class="font-semibold text-gray-900">Final:</span> 3 mejores parejas</p>
        </div>
      </article>
    </div>
    <p class="mt-8 max-w-2xl border-l-2 border-brand-500/30 pl-4 text-sm italic text-gray-500">
      Bases de ejemplo: actualiza esta sección con el reglamento oficial de la edición {FESTIVAL.year} cuando esté
      disponible.
    </p>
  </section>

  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-6xl px-5 lg:px-8">
      <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-brand-600">Categorías</p>
      <h2 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
        Modalidades
      </h2>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {MODALIDADES.map((cat) => (
          <article class="flex flex-col rounded-sm border border-gray-100 bg-cream-50 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-xl">
            <div class="flex items-center justify-between">
              <span class="font-heading text-3xl font-extrabold text-gray-200">{cat.id}</span>
              <span class="rounded-sm bg-brand-600/10 px-2.5 py-1 text-[9px] font-bold uppercase tracking-[0.15em] text-brand-700">
                {cat.subtitle}
              </span>
            </div>
            <h3 class="mt-3 font-heading text-lg font-bold text-gray-900">{cat.title}</h3>
            <div class="mt-3 h-0.5 w-8 bg-gray-200"></div>
            <ul class="mt-4 flex-1 space-y-1.5">
              {cat.levels.map((level) => (
                <li class="flex flex-col border-b border-gray-100 pb-1 last:border-0 last:pb-0">
                  <strong class="text-xs font-bold text-gray-800">{level.name}</strong>
                  <span class="text-[11px] text-gray-400">{level.age}</span>
                </li>
              ))}
            </ul>
            {cat.note && <p class="mt-3 border-t border-gray-100 pt-3 text-[11px] italic text-red-500">{cat.note}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
    <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-brand-600">Galería</p>
    <h2 class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
      Momentos del festival
    </h2>

    <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
      {galleryImages.map((src, i) => (
        <Image
          src={src}
          alt={`${FESTIVAL.name} — foto ${i + 1}`}
          class="aspect-square w-full rounded-sm object-cover transition-transform duration-300 hover:scale-[1.03]"
          width={400}
          loading="lazy"
        />
      ))}
    </div>
  </section>

  <section class="relative overflow-hidden bg-gradient-to-br from-brand-600 to-brand-700">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-5 py-20 text-center lg:flex-row lg:justify-between lg:px-8 lg:text-left">
      <div class="max-w-xl">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Sé parte del {FESTIVAL.name}
        </h2>
        <p class="mt-3 text-base leading-relaxed text-white/80">
          La convocatoria para la {FESTIVAL.edition} se publicará próximamente. Síguenos en redes y no te la pierdas.
        </p>
      </div>
      <a
        href={SITE.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center justify-center rounded-sm bg-white px-8 py-4 text-xs font-black uppercase tracking-[0.15em] text-brand-700 transition-all hover:bg-gray-100"
      >
        Consultas por WhatsApp
      </a>
    </div>
  </section>
</Layout>