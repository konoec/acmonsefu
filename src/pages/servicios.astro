---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/site";
import { FESTIVAL } from "../data/festival";

const servicios = [
  {
    title: "Shows de danzas tradicionales",
    text: "Presentaciones de marinera, tondero y baile tierra para empresas, instituciones, eventos privados y fechas especiales.",
    features: ["Elenco profesional", "Vestuario tradicional", "Adaptación a tu evento"],
  },
  {
    title: "Festivales y concursos",
    text: "Organización de eventos competitivos de danza, como el Festival Golpe Tierra, con jurado especializado y logística completa.",
    features: ["Bases y reglamento", "Jurado calificador", "Premiación y difusión"],
  },
  {
    title: "Talleres y formación",
    text: "Clases y talleres de danzas tradicionales para niños, jóvenes y adultos que quieren aprender y perfeccionar su técnica.",
    features: ["Profesores especializados", "Niveles y categorías", "Certificación"],
  },
  {
    title: "Eventos institucionales",
    text: "Apoyo y participación en actividades culturales de instituciones educativas, gobiernos locales y organizaciones.",
    features: ["Actos protocolares", "Números artísticos", "Asesoría cultural"],
  },
];

const iconos = [
  "M15 15l-2 5l-3-2l-1 3l-3-3l-3 2V9a6 6 0 0 1 6-6h2a6 6 0 0 1 6 6v6Z",
  "M8 21h8m-4-4V5m0 0L8 9m4-4l4 4",
  "M14.7 6.3a4.5 4.5 0 0 0-6 6L3 18l3 3 5.7-5.7a4.5 4.5 0 0 0 6-6L13 14l-3-3 4.7-4.7Z",
  "M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0H3m16 0h2m-16 0H3M9 7h1m4 0h1M9 11h1m4 0h1M9 15h1m4 0h1",
];
---

<Layout
  title="Servicios"
  description="Espectáculos de danzas tradicionales, festivales, concursos y talleres culturales de AC Monsefú."
>
  <section class="border-b border-gray-100 bg-cream-50">
    <div class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
      <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-brand-600">Servicios</p>
      <h1 class="mt-3 max-w-2xl font-heading text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
        Cultura para tu evento
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-600">
        Llevamos la danza tradicional a empresas, instituciones y escenarios de todo tipo. Contrata nuestros
        espectáculos y participa en nuestros eventos.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {servicios.map((service, i) => (
        <article class="flex flex-col rounded-sm border border-gray-100 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-xl">
          <div class="flex h-12 w-12 items-center justify-center rounded-sm bg-brand-600/10 text-brand-600">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
              <path d={iconos[i]} />
            </svg>
          </div>
          <h2 class="mt-5 font-heading text-xl font-bold text-gray-900">{service.title}</h2>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-gray-500">{service.text}</p>
          <ul class="mt-5 space-y-2 border-t border-gray-100 pt-5">
            {service.features.map((feature) => (
              <li class="flex items-center gap-2 text-sm text-gray-600">
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-brand-600/10 text-brand-600">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                {feature}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="relative overflow-hidden bg-gradient-to-br from-gray-900 to-gray-800">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-5 py-20 text-center lg:flex-row lg:justify-between lg:px-8 lg:text-left">
      <div class="max-w-xl">
        <h2 class="font-heading text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Contrata un espectáculo
        </h2>
        <p class="mt-3 text-base leading-relaxed text-white/80">
          Escríbenos por WhatsApp y coordinemos juntos la mejor experiencia cultural para tu evento. También puedes
          consultar por la próxima edición del {FESTIVAL.name}.
        </p>
      </div>
      <a
        href={SITE.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-2 rounded-sm bg-brand-600 px-8 py-4 text-xs font-black uppercase tracking-[0.15em] text-white transition-all hover:bg-brand-500"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.9-1.4A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20Zm4.5-6c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4 0-.5.1-.6l.5-.6c.1-.2.1-.3.2-.5v-.5c0-.1-.5-1.2-.7-1.6-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4 0-.6.3-.2.3-.8.8-.8 1.9s.8 2.2.9 2.4c.1.2 1.6 2.5 3.9 3.5.5.2.9.4 1.3.5.5.2 1 .1 1.4.1.4-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z" />
        </svg>
        Escríbenos por WhatsApp
      </a>
    </div>
  </section>
</Layout>